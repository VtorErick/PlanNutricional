{
  "expo": {
    "name": "Plan Nutricional",
    "slug": "plannutricional123",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plannutricional",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plannutricional.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Para escanear reportes médicos",
        "NSPhotoLibraryUsageDescription": "Para adjuntar reportes médicos"
      }
    },
    "android": {
      "package": "com.plannutricional.mobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a47bbb69-3c8a-4c16-b799-28a7902178b2"
      }
    },
    "owner": "vtorericks-organization123"
  }
}
